{% extends 'email/layout.html.twig' %}
{% import 'email/_parts.html.twig' as parts %}

{% block preheader %}Ce lien est valable une heure.{% endblock %}

{% block content %}
  <tr>
    <td class="panel pad" style="border-left: 2px solid #7A1018;">
      <img src="{{ site }}/email/sigil.png" width="48" height="48" alt="" style="margin-bottom: 24px;">
      <div class="label accent">Votre compte</div>
      <h1 class="title" style="padding-top: 14px;">Nouveau<br>mot de passe.</h1>
      <p class="text" style="padding-top: 18px;">Bonsoir, {{ firstName }}. Une demande de réinitialisation a été faite pour votre compte NOCTIS. Choisissez votre nouveau mot de passe&nbsp;:</p>
      <div style="padding-top: 28px;">{{ parts.button('Choisir un mot de passe', resetUrl) }}</div>
      <p class="label" style="padding-top: 28px; margin: 0; line-height: 18px;">Ce lien est valable une heure. Si vous n’êtes pas à l’origine de cette demande, ignorez ce message&nbsp;: votre mot de passe ne change pas.</p>
    </td>
  </tr>
  <tr>
    <td style="padding: 16px 0 0;">
      <p class="label" style="margin: 0; letter-spacing: 1px; text-transform: none;">Le bouton ne s’ouvre pas&nbsp;? Copiez ce lien&nbsp;: <a href="{{ resetUrl }}" style="color: #8E8880; word-break: break-all;">{{ resetUrl }}</a></p>
    </td>
  </tr>
{% endblock %}
