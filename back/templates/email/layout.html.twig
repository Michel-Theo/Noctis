{#
  Mise en page commune des e-mails NOCTIS (DA « Nuit »).
  Tableaux de 600 px, styles inlinés par inline_css : la plupart des messageries ignorent <style>.
  Les polices de la marque (Google Fonts) s'affichent dans Apple Mail et quelques autres ; ailleurs, replis système.
#}
{% apply inline_css %}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <meta name="supported-color-schemes" content="dark">
  <title>{{ subject_line }}</title>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Michroma&family=Space+Grotesk:wght@400;500&family=Syne:wght@600&display=swap" rel="stylesheet">
  <style>
    body { margin: 0; padding: 0; background-color: #0B0A0C; color: #E7E1D5; font-family: 'Space Grotesk', Arial, Helvetica, sans-serif; }
    table { border-collapse: collapse; }
    img { border: 0; display: block; }
    a { color: #E7E1D5; }
    .wrap { width: 100%; background-color: #0B0A0C; }
    .card { width: 600px; max-width: 600px; }
    .panel { background-color: #141215; }
    .pad { padding: 32px 40px; }
    .label { font-family: 'JetBrains Mono', 'Courier New', Courier, monospace; font-size: 11px; line-height: 16px; letter-spacing: 2px; text-transform: uppercase; color: #8E8880; }
    .accent { color: #D9464F; }
    .title { margin: 0; font-family: Michroma, Arial, Helvetica, sans-serif; font-weight: 400; font-size: 28px; line-height: 38px; letter-spacing: 3px; color: #E7E1D5; }
    .heading { margin: 0; font-family: Syne, Arial, Helvetica, sans-serif; font-weight: 600; font-size: 20px; line-height: 28px; color: #E7E1D5; }
    .text { margin: 0; font-size: 16px; line-height: 26px; color: #8E8880; }
    .strong { color: #E7E1D5; }
    .mono { font-family: 'JetBrains Mono', 'Courier New', Courier, monospace; font-size: 14px; color: #E7E1D5; }
    .rule { border-top: 1px solid #2A272B; }
    .btn { display: inline-block; padding: 15px 30px; background-color: #7A1018; color: #E7E1D5; font-family: 'JetBrains Mono', 'Courier New', Courier, monospace; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; text-decoration: none; }
    .quote { border-left: 1px solid #7A1018; padding: 4px 0 4px 20px; font-size: 16px; line-height: 26px; color: #E7E1D5; white-space: pre-line; }
    .footer { padding: 32px 0 8px; font-family: 'JetBrains Mono', 'Courier New', Courier, monospace; font-size: 11px; line-height: 18px; letter-spacing: 1px; color: #5E5952; text-align: center; }
    .footer a { color: #8E8880; }
  </style>
</head>
<body>
  {# Texte d'aperçu affiché par les messageries à côté du sujet. #}
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;">{% block preheader %}{% endblock %}</div>
  <table role="presentation" class="wrap" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center" style="padding: 40px 16px;">
        <table role="presentation" class="card" width="600" cellpadding="0" cellspacing="0">
          <tr>
            <td style="padding: 0 0 32px;">
              <a href="{{ site }}"><img src="{{ email.image('@images/logo.png') }}" width="180" alt="NOCTIS"></a>
            </td>
          </tr>
          {% block content %}{% endblock %}
          <tr>
            <td class="footer">
              NOCTIS · Projet portfolio — aucune vente réelle<br>
              <a href="{{ site }}">{{ site|replace({'https://': '', 'http://': ''}) }}</a>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
{% endapply %}
